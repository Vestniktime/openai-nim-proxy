# Скопируйте этот файл в .env и заполните значения

# GitHub Personal Access Token (нужны права: models:read)
# Получить: https://github.com/settings/tokens → Fine-grained tokens
GITHUB_TOKEN=your_github_pat_here

# Модель Nvidia NIM / GitHub Models
# Доступные DeepSeek модели: deepseek/deepseek-v3-0324
MODEL=deepseek/deepseek-v3-0324

# Порт сервера
PORT=3000
